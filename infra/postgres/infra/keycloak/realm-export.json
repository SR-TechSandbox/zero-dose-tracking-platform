{
  "realm": "zero-dose-realm",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": false,
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "roles": {
    "realm": [
      {
        "name": "admin",
        "description": "Campaign administrator with full read/write access"
      },
      {
        "name": "field_worker",
        "description": "Field worker able to log beneficiaries and vaccinations"
      }
    ]
  },
  "clients": [
    {
      "clientId": "zd-frontend",
      "name": "Zero-Dose Frontend SPA",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "https://localhost/*",
        "http://localhost:5173/*"
      ],
      "webOrigins": [
        "https://localhost",
        "http://localhost:5173"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      }
    },
    {
      "clientId": "zd-cli-test",
      "name": "Zero-Dose CLI & CI Test Client",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true
    }
  ],
  "users": [
    {
      "username": "admin.user",
      "email": "admin@zerodose.local",
      "firstName": "Campaign",
      "lastName": "Admin",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "AdminPass123!",
          "temporary": false
        }
      ],
      "realmRoles": [
        "admin"
      ]
    },
    {
      "username": "worker.user",
      "email": "worker@zerodose.local",
      "firstName": "Field",
      "lastName": "Worker",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "WorkerPass123!",
          "temporary": false
        }
      ],
      "realmRoles": [
        "field_worker"
      ]
    }
  ]
}