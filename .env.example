# ==============================================================================
# Zero-Dose Tracking Platform — Environment Configuration (Dev / CI Defaults)
# Copy to .env before running Docker Compose: cp .env.example .env
# ==============================================================================

# --- PostgreSQL 18 (Superuser) ---
POSTGRES_USER=zd_superuser
POSTGRES_PASSWORD=zd_super_secret_dev
POSTGRES_DB=postgres

# --- Isolated Service Database Credentials ---
CAMPAIGN_DB_NAME=campaign_db
CAMPAIGN_DB_USER=campaign_user
CAMPAIGN_DB_PASSWORD=campaign_pass_dev

TRACKING_DB_NAME=tracking_db
TRACKING_DB_USER=tracking_user
TRACKING_DB_PASSWORD=tracking_pass_dev

KEYCLOAK_DB_NAME=keycloak_db
KEYCLOAK_DB_USER=keycloak_user
KEYCLOAK_DB_PASSWORD=keycloak_pass_dev

# --- Keycloak (IAM) ---
KEYCLOAK_ADMIN=kc_admin
KEYCLOAK_ADMIN_PASSWORD=kc_admin_pass_dev
KC_HOSTNAME=localhost
KC_REALM=zero-dose-realm

# --- Kong OSS (DB-less API Gateway) ---
KONG_LOG_LEVEL=warn

# --- Shared Backend Auth Config (Used in Phase 2+) ---
JWKS_URL=http://zd-keycloak:8080/realms/zero-dose-realm/protocol/openid-connect/certs
JWT_ISSUER=https://localhost/auth/realms/zero-dose-realm
